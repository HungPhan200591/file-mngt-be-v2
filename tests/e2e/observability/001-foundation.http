###
# @name PrometheusTargets
GET {{prometheusBaseUrl}}/api/v1/targets?state=active

> {%
  var expectedJobs = ["gateway-service", "catalog-service", "scan-service", "query-service", "media-worker"];
  var targets = response.body.data && response.body.data.activeTargets || [];
  var healthyJobs = targets
    .filter(function(target) { return target.health === "up"; })
    .map(function(target) { return target.labels.job; });
  client.test("scrapes all five services", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    expectedJobs.forEach(function(job) {
      client.assert(healthyJobs.includes(job), "Expected healthy Prometheus target " + job);
    });
  });
%}

###
# @name CorrelatedGatewayRequest
GET {{gatewayBaseUrl}}/api/v2/query/subjects?size=1
X-Correlation-Id: {{correlationId}}

> {%
  client.test("preserves correlation ID for log lookup", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(
      response.headers.valueOf("X-Correlation-Id") === "E2E-observability-001",
      "Expected preserved X-Correlation-Id"
    );
  });
%}
