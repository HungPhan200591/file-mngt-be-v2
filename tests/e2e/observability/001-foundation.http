@correlationId = E2E-observability-001

###
# @name GatewayPrometheus
GET {{gatewayBaseUrl}}/actuator/prometheus

> {%
  client.test("exposes Gateway Prometheus metrics", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(String(response.body).includes("jvm_info"), "Expected JVM metrics");
  });
%}

###
# @name CatalogPrometheus
GET {{catalogBaseUrl}}/actuator/prometheus

> {%
  client.test("exposes Catalog Prometheus metrics", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(String(response.body).includes("application=\"catalog-service\""), "Expected application tag");
  });
%}

