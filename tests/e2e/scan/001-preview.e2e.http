@baseUrl = {{scanBaseUrl}}
@catalogBaseUrl = {{catalogBaseUrl}}

@scanCompleted = false
@scanFailed = false
@scanPollAttempts = 0
@rejectScanCompleted = false
@rejectScanFailed = false
@rejectScanPollAttempts = 0
@catalogSubjectFound = false
@catalogPollAttempts = 0

###
# @name StartScanPreview
POST {{baseUrl}}/api/v2/scans/previews
Content-Type: application/json

{ "rootKey": "{{scanFixtureRootKey}}" }

{{response
  const run = JSON.parse(response.body);
  exports.scanRunId = run.id;
  test('accepts scan', () => response.statusCode === 202);
}}

###
# @name WaitForScanCompletion
# @loop while scanCompleted !== true && scanFailed !== true && scanPollAttempts < 50
GET {{baseUrl}}/api/v2/scans/{{scanRunId}}

{{response
  const run = JSON.parse(response.body);
  exports.scanCompleted = run.status === 'COMPLETED';
  exports.scanFailed = run.status === 'FAILED';
  exports.scanPollAttempts = Number(scanPollAttempts) + 1;
  if (!scanCompleted && !scanFailed) {
    await sleep(100);
  }
}}

###
# @name AssertScanCompleted
GET {{baseUrl}}/api/v2/scans/{{scanRunId}}

{{response
  const run = JSON.parse(response.body);
  test('completes scan', () => run.status === 'COMPLETED');
}}

###
# @name ListScanProposals
GET {{baseUrl}}/api/v2/scans/{{scanRunId}}/proposals

{{response
  const page = JSON.parse(response.body);
  const proposal = page.content[0];
  exports.scanProposalId = proposal?.id;
  exports.scanIdentityKey = proposal?.identityKey;
  exports.scanAssetRole = proposal?.assetRole;
  exports.scanRelativePath = proposal?.sourceRelativePath;
  test('lists one proposal', () => response.statusCode === 200 && page.totalElements === 1);
}}

###
# @name ListScanIssues
GET {{baseUrl}}/api/v2/scans/{{scanRunId}}/issues

{{response
  const page = JSON.parse(response.body);
  test('lists one issue', () => response.statusCode === 200 && page.totalElements === 1);
}}

###
# @name ApproveScanProposal
POST {{baseUrl}}/api/v2/scans/{{scanRunId}}/proposals/{{scanProposalId}}/decision
Content-Type: application/json

{ "decision": "APPROVE" }

{{response
  const decision = JSON.parse(response.body);
  exports.approvedEventId = decision.eventId;
  test('approves proposal with outbox event', () =>
    response.statusCode === 200 && decision.decision === 'APPROVE' && Boolean(decision.eventId));
}}

###
# @name RepeatApproveScanProposal
POST {{baseUrl}}/api/v2/scans/{{scanRunId}}/proposals/{{scanProposalId}}/decision
Content-Type: application/json

{ "decision": "APPROVE" }

{{response
  const decision = JSON.parse(response.body);
  test('returns the same approval', () =>
    response.statusCode === 200 && decision.eventId === approvedEventId);
}}

###
# @name WaitForCatalogSubject
# @loop while catalogPollAttempts < 40
GET {{catalogBaseUrl}}/api/v2/catalog/subjects?region=JOKE&subjectType=VIDEO&identityKey={{scanIdentityKey}}&size=1

{{response
  const page = JSON.parse(response.body);
  const subject = page.content[0];
  const asset = subject?.assets?.find(item =>
    item.role === scanAssetRole && item.relativePath === scanRelativePath);
  exports.catalogSubjectFound = response.statusCode === 200
    && page.totalElements === 1
    && subject?.identityKey === scanIdentityKey
    && subject?.region === 'JOKE'
    && subject?.subjectType === 'VIDEO'
    && Boolean(asset);
  exports.catalogPollAttempts = catalogSubjectFound
    ? 40
    : Number(catalogPollAttempts) + 1;
  if (!catalogSubjectFound) {
    await sleep(250);
  }
}}

###
# @name AssertCatalogSubject
GET {{catalogBaseUrl}}/api/v2/catalog/subjects?region=JOKE&subjectType=VIDEO&identityKey={{scanIdentityKey}}&size=1

{{response
  const page = JSON.parse(response.body);
  const subject = page.content[0];
  const matchingAssets = subject?.assets?.filter(item =>
    item.role === scanAssetRole && item.relativePath === scanRelativePath) ?? [];
  test('creates exactly one Catalog subject and asset', () =>
    response.statusCode === 200
    && page.totalElements === 1
    && subject?.identityKey === scanIdentityKey
    && subject?.region === 'JOKE'
    && subject?.subjectType === 'VIDEO'
    && subject?.assets?.length === 1
    && matchingAssets.length === 1);
}}

###
# @name StartRejectScanPreview
POST {{baseUrl}}/api/v2/scans/previews
Content-Type: application/json

{ "rootKey": "{{scanFixtureRootKey}}" }

{{response
  const run = JSON.parse(response.body);
  exports.rejectScanRunId = run.id;
  test('accepts second scan', () => response.statusCode === 202);
}}

###
# @name WaitForRejectScanCompletion
# @loop while rejectScanCompleted !== true && rejectScanFailed !== true && rejectScanPollAttempts < 50
GET {{baseUrl}}/api/v2/scans/{{rejectScanRunId}}

{{response
  const run = JSON.parse(response.body);
  exports.rejectScanCompleted = run.status === 'COMPLETED';
  exports.rejectScanFailed = run.status === 'FAILED';
  exports.rejectScanPollAttempts = Number(rejectScanPollAttempts) + 1;
  if (!rejectScanCompleted && !rejectScanFailed) {
    await sleep(100);
  }
}}

###
# @name ListRejectScanProposals
GET {{baseUrl}}/api/v2/scans/{{rejectScanRunId}}/proposals

{{response
  const page = JSON.parse(response.body);
  const proposalId = page.content[0]?.id;
  exports.rejectScanProposalId = proposalId;
  test('lists proposal for rejection', () =>
    response.statusCode === 200 && page.totalElements === 1 && Boolean(proposalId));
}}

###
# @name RejectScanProposal
POST {{baseUrl}}/api/v2/scans/{{rejectScanRunId}}/proposals/{{rejectScanProposalId}}/decision
Content-Type: application/json

{ "decision": "REJECT" }

{{response
  const decision = JSON.parse(response.body);
  test('rejects proposal without event', () =>
    response.statusCode === 200 && decision.decision === 'REJECT' && decision.eventId === null);
}}
