@baseUrl = {{scanBaseUrl}}

###
# @name StartScanPreview
POST {{baseUrl}}/api/v2/scans/previews
Content-Type: application/json

{ "rootKey": "{{scanFixtureRootKey}}" }

> {%
  client.global.set("scanRunId", response.body.id);
  client.test("accepts scan", function() {
    client.assert(response.status === 202, "Expected 202, got " + response.status);
  });
%}

###
# Chạy StartScanPreview trước để lưu scanRunId.
# @name GetScanRun
GET {{baseUrl}}/api/v2/scans/{{scanRunId}}

> {%
  client.test("gets scan run", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
  });
%}

###
# @name ListScanProposals
GET {{baseUrl}}/api/v2/scans/{{scanRunId}}/proposals

> {%
  client.global.set("scanProposalId", response.body.content[0].id);
  client.test("lists proposals", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(response.body.content.length > 0, "Expected at least one proposal");
  });
%}

###
# @name ListScanIssues
GET {{baseUrl}}/api/v2/scans/{{scanRunId}}/issues

> {% client.test("lists issues", function() { client.assert(response.status === 200, "Expected 200, got " + response.status); }); %}

###
# Chọn một decision cho proposal hiện tại. Muốn thử decision còn lại, chạy lại từ StartScanPreview để có proposal mới.
# @name ApproveScanProposal
POST {{baseUrl}}/api/v2/scans/{{scanRunId}}/proposals/{{scanProposalId}}/decision
Content-Type: application/json

{ "decision": "APPROVE" }

> {%
  client.global.set("scanApprovedEventId", response.body.eventId);
  client.test("approves proposal", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(response.body.eventId !== null, "Expected an outbox eventId");
  });
%}

###
# @name RepeatApproveScanProposal
POST {{baseUrl}}/api/v2/scans/{{scanRunId}}/proposals/{{scanProposalId}}/decision
Content-Type: application/json

{ "decision": "APPROVE" }

> {%
  client.test("returns the same approval", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(response.body.eventId === client.global.get("scanApprovedEventId"), "Expected the same eventId");
  });
%}

###
# Catalog consumer xử lý bất đồng bộ; chạy lại request này nếu Kafka chưa kịp publish/consume.
# @name AssertCatalogSubject
GET {{catalogBaseUrl}}/api/v2/catalog/subjects?region=JOKE&subjectType=VIDEO&identityKey=JOKE-001&size=1

> {%
  client.test("creates exactly one Catalog subject and asset", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(response.body.totalElements === 1, "Expected one Catalog subject");
    client.assert(response.body.content[0].identityKey === "JOKE-001", "Expected fixture identity");
    client.assert(response.body.content[0].region === "JOKE", "Expected JOKE region");
    client.assert(response.body.content[0].subjectType === "VIDEO", "Expected VIDEO subject");
    client.assert(response.body.content[0].assets.length === 1, "Expected one Catalog asset");
    client.assert(response.body.content[0].assets[0].role === "PRIMARY_VIDEO", "Expected primary video");
    client.assert(response.body.content[0].assets[0].relativePath === "A - [JOKE-001].mp4", "Expected fixture path");
  });
%}

###
# Chỉ chạy sau khi đã tạo một scan/proposal mới chưa có decision.
# @name RejectScanProposal
POST {{baseUrl}}/api/v2/scans/{{scanRunId}}/proposals/{{scanProposalId}}/decision
Content-Type: application/json

{ "decision": "REJECT" }

> {%
  client.test("rejects proposal without event", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(response.body.eventId === null, "Expected no eventId");
  });
%}
